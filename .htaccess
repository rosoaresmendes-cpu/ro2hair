# ── COMPRESSÃO GZIP ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE text/xml text/plain
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf
</IfModule>

# ── CACHE DO NAVEGADOR ───────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Imagens — 1 mês
  ExpiresByType image/webp                    "access plus 1 month"
  ExpiresByType image/png                     "access plus 1 month"
  ExpiresByType image/jpeg                    "access plus 1 month"
  ExpiresByType image/svg+xml                 "access plus 1 month"
  ExpiresByType image/x-icon                  "access plus 1 month"

  # Fontes — 1 mês
  ExpiresByType font/woff2                    "access plus 1 month"
  ExpiresByType font/woff                     "access plus 1 month"
  ExpiresByType font/ttf                      "access plus 1 month"

  # CSS e JS — 1 mês
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType application/javascript        "access plus 1 month"
  ExpiresByType text/javascript               "access plus 1 month"

  # HTML — sem cache (sempre busca a versão mais recente)
  ExpiresByType text/html                     "access plus 0 seconds"
</IfModule>

# ── SEGURANÇA ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Bloqueia carregamento do site em iframe por terceiros
  Header always set X-Frame-Options "SAMEORIGIN"

  # Bloqueia detecção automática de tipo de conteúdo
  Header always set X-Content-Type-Options "nosniff"

  # Força HTTPS se o domínio tiver SSL ativo
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Remove a versão do servidor da resposta
  Header unset X-Powered-By
</IfModule>

# ── REDIRECIONAR TUDO PARA INDEX.HTML (SPA) ──────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redireciona www para sem www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Redireciona HTTP para HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
